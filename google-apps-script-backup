/***************************************************************
 * NORMALIZE LINE / HOUR
 *
 * Converts:
 *   Line 1   -> 1
 *   LINE3    -> 3
 *   L5       -> 5
 *   H11      -> 11
 *   Hour 5   -> 5
 *   H-7      -> 7
 *   07       -> 7
 *
 * Returns blank when no number is found.
 ***************************************************************/
function normalizeNumber_(value) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {
        return "";
    }

    // Already a number
    if (
        typeof value === "number" &&
        !isNaN(value)
    ) {
        return value;
    }

    // Convert text
    const text = String(value).trim();

    if (!text) {
        return "";
    }

    // Extract number from anywhere in text
    const match = text.match(/\d+/);

    if (!match) {
        return "";
    }

    return Number(match[0]);
}




