/***************************************************************
 * CLEAN + LOCK LINE / HOUR COLUMNS
 *
 * ONE-CLICK FUNCTION
 *
 * INPUT:
 *   C = LINE  → 1 to 14 only
 *   D = HOUR  → 1 to 11 only
 *
 * QUALITY INPUT:
 *   C = LINE  → 1 to 14 only
 *
 * APP/DASHBOARD:
 *   Line 1, Line 2, ... Line 14
 *
 * GOOGLE SHEET:
 *   1, 2, ... 14
 *
 * Converts existing values:
 *
 *   Line 1  → 1
 *   Line 2  → 2
 *   LINE3   → 3
 *   LINE 14 → 14
 *   L5      → 5
 *
 * After conversion, ONLY numeric values are accepted.
 ***************************************************************/
function cleanAndLockLineHourColumns() {

    const ss = SpreadsheetApp.getActiveSpreadsheet();

    const INPUT_SHEET = "INPUT";
    const QUALITY_SHEET = "QUALITY INPUT";


    /***********************************************************
     * LOCAL NUMBER CONVERTER
     ***********************************************************/
    function extractNumber(value) {

        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {
            return "";
        }

        // Already a number
        if (typeof value === "number") {

            if (isNaN(value)) {
                return "";
            }

            return value;
        }

        // Convert text such as:
        // Line 1 → 1
        // LINE3 → 3
        // L5 → 5
        const text = String(value).trim();

        if (!text) {
            return "";
        }

        // Find first number anywhere in text
        const match = text.match(/\d+/);

        if (!match) {
            return "";
        }

        return Number(match[0]);
    }


    /***********************************************************
     * INPUT SHEET
     ***********************************************************/
    const input = ss.getSheetByName(INPUT_SHEET);

    if (!input) {
        throw new Error(
            'Sheet "' + INPUT_SHEET + '" was not found.'
        );
    }


    const inputLastRow =
        Math.max(input.getLastRow(), 2);

    const inputRows =
        inputLastRow - 1;


    /***********************************************************
     * INPUT — COLUMN C — LINE
     *
     * APP SENDS:
     *   Line 1
     *   Line 5
     *   Line 14
     *
     * SHEET STORES:
     *   1
     *   5
     *   14
     ***********************************************************/
    const inputLineRange =
        input.getRange(
            2,
            3,
            inputRows,
            1
        );

    const inputLineValues =
        inputLineRange.getValues();

    const cleanedInputLines =
        inputLineValues.map(function (row) {

            const value =
                extractNumber(row[0]);

            /*
             * Only accept valid production lines.
             * Anything outside 1–14 becomes blank.
             */
            if (
                value === "" ||
                value < 1 ||
                value > 14
            ) {
                return [""];
            }

            // Store as NUMBER, never "Line 1"
            return [Number(value)];
        });

    inputLineRange.setValues(
        cleanedInputLines
    );


    /***********************************************************
     * INPUT — COLUMN D — HOUR
     ***********************************************************/
    const inputHourRange =
        input.getRange(
            2,
            4,
            inputRows,
            1
        );

    const inputHourValues =
        inputHourRange.getValues();

    const cleanedInputHours =
        inputHourValues.map(function (row) {

            const value =
                extractNumber(row[0]);

            /*
             * Only accept valid production hours.
             * Anything outside 1–11 becomes blank.
             */
            if (
                value === "" ||
                value < 1 ||
                value > 11
            ) {
                return [""];
            }

            return [Number(value)];
        });

    inputHourRange.setValues(
        cleanedInputHours
    );


    /***********************************************************
     * STRICT VALIDATION — INPUT LINE
     *
     * IMPORTANT:
     * SHEET ACCEPTS NUMBERS ONLY.
     * 1–14
     ***********************************************************/
    const lineRule =
        SpreadsheetApp.newDataValidation()
            .requireNumberBetween(1, 14)
            .setAllowInvalid(false)
            .setHelpText(
                "Enter Line number only: 1 to 14."
            )
            .build();

    input
        .getRange(
            2,
            3,
            Math.max(input.getMaxRows() - 1, 1),
            1
        )
        .setDataValidation(lineRule);


    /***********************************************************
     * STRICT VALIDATION — INPUT HOUR
     ***********************************************************/
    const hourRule =
        SpreadsheetApp.newDataValidation()
            .requireNumberBetween(1, 11)
            .setAllowInvalid(false)
            .setHelpText(
                "Enter Hour number only: 1 to 11."
            )
            .build();

    input
        .getRange(
            2,
            4,
            Math.max(input.getMaxRows() - 1, 1),
            1
        )
        .setDataValidation(hourRule);


    /***********************************************************
     * QUALITY INPUT
     ***********************************************************/
    const quality =
        ss.getSheetByName(QUALITY_SHEET);

    if (quality) {

        const qualityLastRow =
            Math.max(quality.getLastRow(), 2);

        const qualityRows =
            qualityLastRow - 1;


        /*******************************************************
         * QUALITY — COLUMN C — LINE
         *
         * APP:
         *   Line 1
         *
         * SHEET:
         *   1
         *******************************************************/
        const qualityLineRange =
            quality.getRange(
                2,
                3,
                qualityRows,
                1
            );

        const qualityLineValues =
            qualityLineRange.getValues();

        const cleanedQualityLines =
            qualityLineValues.map(function (row) {

                const value =
                    extractNumber(row[0]);

                if (
                    value === "" ||
                    value < 1 ||
                    value > 14
                ) {
                    return [""];
                }

                // Store as NUMBER
                return [Number(value)];
            });

        qualityLineRange.setValues(
            cleanedQualityLines
        );


        /*******************************************************
         * STRICT VALIDATION — QUALITY LINE
         *
         * NUMBERS ONLY: 1–14
         *******************************************************/
        const qualityLineRule =
            SpreadsheetApp.newDataValidation()
                .requireNumberBetween(1, 14)
                .setAllowInvalid(false)
                .setHelpText(
                    "Enter Line number only: 1 to 14."
                )
                .build();

        quality
            .getRange(
                2,
                3,
                Math.max(quality.getMaxRows() - 1, 1),
                1
            )
            .setDataValidation(
                qualityLineRule
            );
    }


    /***********************************************************
     * FINISH
     ***********************************************************/
    SpreadsheetApp.flush();


    // Refresh dashboard if your function exists
    try {
        updateProductionDisplay();
    } catch (err) {
        console.log(
            "Dashboard refresh skipped: " +
            err.message
        );
    }


    SpreadsheetApp.getUi().alert(
        "LINE / HOUR CLEANUP COMPLETE\n\n" +
        "INPUT Column C → Numeric Line 1–14\n" +
        "INPUT Column D → Numeric Hour 1–11\n" +
        "QUALITY INPUT Column C → Numeric Line 1–14\n\n" +
        "App format: Line 1, Line 2, etc.\n" +
        "Sheet format: 1, 2, 3, etc.\n\n" +
        "Existing text values have been converted to numbers."
    );
}
/***************************************************************
 * SINGLE SIMPLE EDIT HANDLER — NORMALIZES LINE / HOUR VALUES
 ***************************************************************/
function onEdit(e) {
    if (!e || !e.range) return;

    const sheet = e.range.getSheet();
    const row = e.range.getRow();
    const col = e.range.getColumn();

    // Ignore header
    if (row < 2) return;

    const sheetName = sheet.getName();

    // INPUT: Column C = Line, Column D = Hour
    if (sheetName === "INPUT") {

        // LINE — Column C
        if (col === 3) {
            const value = e.range.getValue();

            if (value !== "" && value !== null) {
                const match = String(value).match(/\d+/);

                if (match) {
                    const line = Number(match[0]);

                    if (line >= 1 && line <= 14) {
                        e.range.setValue(line);
                    }
                }
            }
        }

        // HOUR — Column D
        if (col === 4) {
            const value = e.range.getValue();

            if (value !== "" && value !== null) {
                const match = String(value).match(/\d+/);

                if (match) {
                    const hour = Number(match[0]);

                    if (hour >= 1 && hour <= 11) {
                        e.range.setValue(hour);
                    }
                }
            }
        }
    }


    // QUALITY INPUT: Column C = Line
    if (sheetName === "QUALITY INPUT" && col === 3) {

        const value = e.range.getValue();

        if (value !== "" && value !== null) {
            const match = String(value).match(/\d+/);

            if (match) {
                const line = Number(match[0]);

                if (line >= 1 && line <= 14) {
                    e.range.setValue(line);
                }
            }
        }
    }
}
/***************************************************************
 * CONVERT LINE + HOUR TO NUMBERS
 *
 * Applies to:
 *   1. INPUT
 *   2. QUALITY INPUT
 *
 * DISPLAY FROM VERCEL:
 *   Line 1
 *   Line 2
 *   ...
 *   Line 14
 *
 * STORED IN GOOGLE SHEETS:
 *   1
 *   2
 *   ...
 *   14
 *
 * HOUR:
 *   H1  -> 1
 *   H2  -> 2
 *   ...
 *   H11 -> 11
 ***************************************************************/

function convertAllLineHourValues() {

    var ss = SpreadsheetApp.getActiveSpreadsheet();

    var sheetNames = [
        'INPUT',
        'QUALITY INPUT'
    ];

    sheetNames.forEach(function (sheetName) {

        var sheet = ss.getSheetByName(sheetName);

        if (!sheet) {
            Logger.log('Sheet not found: ' + sheetName);
            return;
        }

        var lastRow = sheet.getLastRow();
        var lastColumn = sheet.getLastColumn();

        if (lastRow < 2) {
            Logger.log('No data in: ' + sheetName);
            return;
        }

        /***********************************************************
         * FIND HEADER COLUMNS
         ***********************************************************/

        var headers = sheet
            .getRange(1, 1, 1, lastColumn)
            .getValues()[0];

        var lineColumn = -1;
        var hourColumn = -1;

        headers.forEach(function (header, index) {

            var headerName = String(header)
                .trim()
                .toLowerCase();

            if (headerName === 'line') {
                lineColumn = index + 1;
            }

            if (headerName === 'hour') {
                hourColumn = index + 1;
            }

        });

        /***********************************************************
         * CONVERT LINE
         ***********************************************************/

        if (lineColumn !== -1) {

            convertLineHourColumn_(
                sheet,
                lineColumn,
                2,
                lastRow,
                1,
                14
            );

            Logger.log(
                sheetName + ': Line column converted.'
            );
        }

        /***********************************************************
         * CONVERT HOUR
         ***********************************************************/

        if (hourColumn !== -1) {

            convertLineHourColumn_(
                sheet,
                hourColumn,
                2,
                lastRow,
                1,
                11
            );

            Logger.log(
                sheetName + ': Hour column converted.'
            );
        }

    });

    SpreadsheetApp.flush();

    Logger.log(
        'DONE: INPUT and QUALITY INPUT converted.'
    );
}


/***************************************************************
 * HELPER FUNCTION
 ***************************************************************/

function convertLineHourColumn_(
    sheet,
    column,
    startRow,
    lastRow,
    minimum,
    maximum
) {

    var rowCount = lastRow - startRow + 1;

    if (rowCount <= 0) return;

    var range = sheet.getRange(
        startRow,
        column,
        rowCount,
        1
    );

    var values = range.getValues();

    var convertedValues = values.map(function (row) {

        var value = row[0];

        /***********************************************************
         * EMPTY CELL
         ***********************************************************/

        if (
            value === '' ||
            value === null ||
            value === undefined
        ) {
            return [''];
        }

        /***********************************************************
         * ALREADY NUMBER
         ***********************************************************/

        if (typeof value === 'number') {

            if (
                value >= minimum &&
                value <= maximum
            ) {
                return [value];
            }

            return [''];
        }

        /***********************************************************
         * TEXT VALUE
         *
         * Examples:
         * Line 1
         * Line 11
         * LINE3
         * LINE 14
         * L5
         * H1
         * H10
         * Hour 5
         ***********************************************************/

        var text = String(value).trim();

        var match = text.match(/\d+/);

        if (!match) {
            return [''];
        }

        var numberValue = Number(match[0]);

        /***********************************************************
         * VALID RANGE
         ***********************************************************/

        if (
            numberValue >= minimum &&
            numberValue <= maximum
        ) {
            return [numberValue];
        }

        return [''];

    });

    /*************************************************************
     * WRITE BACK AS NUMBERS
     *************************************************************/

    range.setValues(convertedValues);

    /*************************************************************
     * NUMBER FORMAT
     *************************************************************/

    range.setNumberFormat('0');
}


