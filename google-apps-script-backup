function ctSetupLineMaster_(ss) {
    let sh = ss.getSheetByName(CT_CONFIG.LINE_SHEET);
    if (!sh) sh = ss.insertSheet(CT_CONFIG.LINE_SHEET);
    const headers = [
        'Line', 'Active', 'Daily Target', 'SMV', 'Manpower', 'Efficiency Target %', 'DHU Target %', 'Working Minutes',
        'Default Buyer', 'Default Style', 'Default PO', 'Default Color',
        'H1 Target', 'H2 Target', 'H3 Target', 'H4 Target', 'H5 Target', 'H6 Target', 'H7 Target', 'H8 Target', 'H9 Target', 'H10 Target', 'H11 Target'
    ];
    if (sh.getLastRow() === 0) sh.getRange(1, 1, 1, headers.length).setValues([headers]);
    else {
        const old = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), headers.length)).getValues()[0];
        headers.forEach((h, i) => { if (!old[i]) sh.getRange(1, i + 1).setValue(h); });
    }
    const existing = sh.getLastRow() >= 2 ? sh.getRange(2, 1, sh.getLastRow() - 1, headers.length).getValues() : [];
    const byLine = {};
    existing.forEach(r => { const n = Number(r[0]); if (n >= 1 && n <= CT_CONFIG.NUMBER_OF_LINES) byLine[n] = r; });
    const rows = [];
    for (let line = 1; line <= CT_CONFIG.NUMBER_OF_LINES; line++) {
        const r = byLine[line] || [];
        const row = new Array(headers.length).fill('');
        row[0] = line;
        row[1] = r[1] === false ? false : true;
        row[2] = r[2] || '';
        row[3] = r[3] || '';
        row[4] = r[4] || '';
        row[5] = r[5] !== '' && r[5] != null ? r[5] : CT_CONFIG.DEFAULT_EFFICIENCY_TARGET;
        row[6] = r[6] || '';
        row[7] = r[7] || CT_CONFIG.DEFAULT_WORK_MINUTES;
        for (let c = 8; c < headers.length; c++) row[c] = r[c] == null ? '' : r[c];
        rows.push(row);
    }
    sh.getRange(2, 1, rows.length, headers.length).setValues(rows);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, headers.length).setBackground('#10233f').setFontColor('#ffffff').setFontWeight('bold');
    sh.getRange(2, 1, rows.length, 1).setNumberFormat('0');
    sh.getRange(2, 3, rows.length, 3).setNumberFormat('0.00');
    sh.getRange(2, 6, rows.length, 2).setNumberFormat('0.0');
    sh.autoResizeColumns(1, headers.length);
}

