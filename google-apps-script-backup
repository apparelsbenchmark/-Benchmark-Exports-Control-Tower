/**
 * API ENTRY POINTS
 *
 * IMPORTANT:
 * - This project must contain exactly ONE active function named doGet and ONE named doPost.
 * - These active handlers live in this EnterpriseApi.gs file.
 * - Rename every older handler in other files to legacyOldDoGet / legacyOldDoPost.
 * - Do not leave duplicate active doGet/doPost declarations anywhere in the project.
 *
 * GET examples:
 *   ?action=health&token=YOUR_TOKEN
 *   ?action=dashboard&date=2026-11-02&token=YOUR_TOKEN
 *   ?action=quality&date=2026-11-02&token=YOUR_TOKEN
 *   ?action=targets&token=YOUR_TOKEN
 *
 * Successful responses always use { ok: true, data: ... }.
 * Errors always use { ok: false, error: "..." }.
 */
function doGet(e) {
    const params = (e && e.parameter) ? e.parameter : {};
    // Never fall back to an old health-check handler. Every request to this
    // Web App must use the Control Tower { ok, data } / { ok, error } envelope.
    return enterpriseApiGet_(params);
}

/** Handle API GET requests and always return the { ok, data } envelope. */
function enterpriseApiGet_(params) {
    try {
        ctAuthorize_(params.token);
        const action = String(params.action || 'dashboard').toLowerCase();
        let result;

        if (action === 'health') {
            result = {
                system: 'BENCHMARK_EXPORTS_CONTROL_TOWER',
                status: 'connected',
                timestamp: new Date().toISOString()
            };
        } else if (action === 'dashboard') {
            result = enterpriseGetDashboard(params.date);
        } else if (action === 'quality') {
            result = enterpriseGetQuality(params.date);
        } else if (action === 'targets') {
            result = enterpriseGetTargets();
        } else {
            throw new Error('Unknown GET action: ' + action);
        }

        return ctJson_({ ok: true, data: result });
    } catch (err) {
        return ctJson_({ ok: false, error: err && err.message ? err.message : String(err) });
    }
}

/** Active API POST entry point. */
function doPost(e) {
    let body;
    try {
        body = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    } catch (err) {
        return ctJson_({ ok: false, error: 'Request body must be valid JSON.' });
    }
    return enterpriseApiPost_(body);
}

/** Handle API POST requests and always return the { ok, data } envelope. */
function enterpriseApiPost_(body) {
    try {
        ctAuthorize_(body.token);
        const action = String(body.action || '').toLowerCase();
        let result;

        if (action === 'production.save') {
            result = enterpriseSaveProduction(body);
        } else if (action === 'quality.save') {
            result = enterpriseSaveQuality(body);
        } else if (action === 'targets.save') {
            result = enterpriseSaveTargets(body);
        } else {
            throw new Error('Unknown POST action: ' + action);
        }

        return ctJson_({ ok: true, data: result });
    } catch (err) {
        return ctJson_({ ok: false, error: err && err.message ? err.message : String(err) });
    }
}

function ctJson_(obj) {
    return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function ctAuthorize_(token) {
    const expected = PropertiesService.getScriptProperties().getProperty(CT_CONFIG.API_TOKEN_KEY);
    if (!expected) throw new Error('API is not initialized. Run setupEnterpriseControlTower() first.');
    if (!token || String(token) !== expected) throw new Error('Unauthorized API request.');
}

function ctSpreadsheet_() {
    const id = PropertiesService.getScriptProperties().getProperty(CT_CONFIG.SPREADSHEET_ID_KEY);
    if (!id) throw new Error('Spreadsheet ID missing. Run setupEnterpriseControlTower() first.');
    return SpreadsheetApp.openById(id);
}

function ctLineRows_() {
    const sh = ctSpreadsheet_().getSheetByName(CT_CONFIG.LINE_SHEET);
    if (!sh || sh.getLastRow() < 2) throw new Error('LINE MASTER is missing. Run setupEnterpriseControlTower().');
    const values = sh.getRange(2, 1, Math.min(CT_CONFIG.NUMBER_OF_LINES, sh.getLastRow() - 1), 23).getValues();
    const map = {};
    values.forEach(r => {
        const line = Number(r[0]);
        if (!line) return;
        const custom = r.slice(12, 23).map(v => v === '' || v == null ? null : Number(v));
        const hasCustom = custom.some(v => v != null && isFinite(v));
        const daily = Number(r[2]) || (hasCustom ? custom.reduce((sum, v) => sum + (Number(v) || 0), 0) : 0);
        const hourly = hasCustom ? custom.map(v => v == null ? 0 : v) : custom.map(() => null);
        map[line] = {
            line,
            active: r[1] !== false && String(r[1]).toLowerCase() !== 'false',
            dailyTarget: daily,
            smv: Number(r[3]) || 0,
            manpower: Number(r[4]) || 0,
            efficiencyTarget: Number(r[5]) || 0,
            dhuTarget: Number(r[6]) || 0,
            workingMinutes: Number(r[7]) || CT_CONFIG.DEFAULT_WORK_MINUTES,
            buyer: String(r[8] || ''), style: String(r[9] || ''), po: String(r[10] || ''), color: String(r[11] || ''),
            hourlyTargets: hourly,
            hasCustomHourlyTargets: hasCustom
        };
    });
    for (let line = 1; line <= CT_CONFIG.NUMBER_OF_LINES; line++) if (!map[line]) map[line] = { line, active: true, dailyTarget: 0, smv: 0, manpower: 0, efficiencyTarget: 0, dhuTarget: 0, workingMinutes: CT_CONFIG.DEFAULT_WORK_MINUTES, buyer: '', style: '', po: '', color: '', hourlyTargets: Array(11).fill(0), hasCustomHourlyTargets: false };
    return map;
}

function enterpriseGetTargets() {
    const lines = ctLineRows_();
    return { lines: Object.keys(lines).map(k => lines[k]).sort((a, b) => a.line - b.line), timestamp: new Date().toISOString() };
}

function enterpriseGetDashboard(dateString) {
    const ss = ctSpreadsheet_();
    const tz = ss.getSpreadsheetTimeZone() || 'Asia/Dhaka';
    const dateKey = ctDateKeyFromInput_(dateString, tz);
    const cache = CacheService.getScriptCache();
    const versionNow = PropertiesService.getScriptProperties().getProperty(CT_CONFIG.POLL_VERSION_KEY) || '1';
    const cacheKey = 'ct_dash_' + dateKey + '_' + versionNow;
    const cached = cache.get(cacheKey);
    if (cached) return JSON.parse(cached);
    const input = ss.getSheetByName(CT_CONFIG.INPUT_SHEET);
    if (!input) throw new Error('INPUT sheet not found.');
    const configs = ctLineRows_();
    const lines = {};
    for (let n = 1; n <= CT_CONFIG.NUMBER_OF_LINES; n++) {
        const c = configs[n];
        const displayTargets = c.hasCustomHourlyTargets ? c.hourlyTargets.map(v => Number(v) || 0) : Array(11).fill(c.dailyTarget > 0 ? c.dailyTarget / 11 : 0);
        lines[n] = Object.assign({}, c, { hourlyTargets: displayTargets, hourlyActual: Array(11).fill(0), actual: 0, maxHour: 0, buyers: [], styles: [], pos: [], achievement: 0, gap: 0, paceTarget: 0, paceAchievement: 0, efficiency: null, earnedMinutes: 0, availableMinutes: 0, status: c.dailyTarget > 0 ? 'WAITING' : 'SET TARGET' });
    }

    const lastRow = input.getLastRow();
    let latestMs = 0;
    if (lastRow >= 2) {
        const rows = input.getRange(2, 1, lastRow - 1, Math.max(9, input.getLastColumn())).getValues();
        rows.forEach(r => {
            if (!r[0] || ctDateKey_(r[0], tz) !== dateKey) return;
            const line = Number(r[2]), hour = Number(r[3]), pcs = Number(r[8]) || 0;
            if (!lines[line] || hour < 1 || hour > 11) return;
            const item = lines[line];
            item.hourlyActual[hour - 1] += pcs;
            item.actual += pcs;
            item.maxHour = Math.max(item.maxHour, hour);
            const buyer = String(r[4] || '').trim(), style = String(r[5] || '').trim(), po = String(r[6] || '').trim();
            if (buyer && item.buyers.indexOf(buyer) < 0) item.buyers.push(buyer);
            if (style && item.styles.indexOf(style) < 0) item.styles.push(style);
            if (po && item.pos.indexOf(po) < 0) item.pos.push(po);
            const stamp = ctCombineDateTime_(r[0], r[1]);
            if (stamp && stamp.getTime() > latestMs) latestMs = stamp.getTime();
        });
    }

    const active = Object.values(lines).filter(x => x.active);
    const currentHour = Math.max.apply(null, active.map(x => x.maxHour).concat([0]));
    let totalTarget = 0, totalActual = 0, totalEarned = 0, totalAvailable = 0, belowTarget = 0;
    const hourly = Array.from({ length: 11 }, (_, i) => ({ hour: i + 1, target: 0, actual: 0, gap: 0 }));
    active.forEach(line => {
        totalTarget += line.dailyTarget;
        totalActual += line.actual;
        line.gap = line.actual - line.dailyTarget;
        line.achievement = line.dailyTarget > 0 ? line.actual / line.dailyTarget * 100 : 0;
        line.earnedMinutes = line.actual * line.smv;
        line.availableMinutes = line.manpower > 0 && currentHour > 0 ? line.manpower * Math.min(currentHour * 60, line.workingMinutes) : 0;
        line.efficiency = line.availableMinutes > 0 && line.smv > 0 ? line.earnedMinutes / line.availableMinutes * 100 : null;
        for (let h = 0; h < 11; h++) {
            hourly[h].target += Number(line.hourlyTargets[h]) || 0;
            hourly[h].actual += line.hourlyActual[h];
        }
        totalEarned += line.earnedMinutes;
        totalAvailable += line.availableMinutes;
    });
    hourly.forEach(h => h.gap = h.actual - h.target);
    active.forEach(line => {
        line.paceTarget = line.hourlyTargets.slice(0, currentHour).reduce((sum, v) => sum + (Number(v) || 0), 0);
        line.paceAchievement = line.paceTarget > 0 ? line.actual / line.paceTarget * 100 : 0;
        if (line.dailyTarget <= 0 && line.paceTarget <= 0) line.status = 'SET TARGET';
        else if (currentHour === 0) line.status = 'WAITING';
        else line.status = line.actual >= line.paceTarget ? (line.actual > line.paceTarget ? 'AHEAD' : 'ON TRACK') : 'BELOW TARGET';
        if (line.status === 'BELOW TARGET') belowTarget++;
    });

    Object.values(lines).forEach(item => {
        if (item.buyers.length) item.buyer = item.buyers.join(' / ');
        if (item.styles.length) item.style = item.styles.join(' / ');
        if (item.pos.length) item.po = item.pos.join(' / ');
    });
    const lineList = Object.values(lines).sort((a, b) => a.line - b.line);
    const ranked = active.filter(x => x.dailyTarget > 0).slice().sort((a, b) => (currentHour ? b.paceAchievement - a.paceAchievement : b.achievement - a.achievement));
    const version = PropertiesService.getScriptProperties().getProperty(CT_CONFIG.POLL_VERSION_KEY) || '1';
    const lastUpdated = PropertiesService.getScriptProperties().getProperty(CT_CONFIG.LAST_UPDATED_KEY) || (latestMs ? new Date(latestMs).toISOString() : null);
    const response = {
        date: dateKey,
        timestamp: new Date().toISOString(),
        lastUpdated,
        dataVersion: version,
        kpis: {
            dailyTarget: totalTarget,
            actual: totalActual,
            gap: totalActual - totalTarget,
            achievement: totalTarget > 0 ? totalActual / totalTarget * 100 : 0,
            efficiency: totalAvailable > 0 ? totalEarned / totalAvailable * 100 : null,
            efficiencyTarget: active.filter(x => x.availableMinutes > 0).reduce((sum, x) => sum + x.efficiencyTarget * x.availableMinutes, 0) / Math.max(1, active.filter(x => x.availableMinutes > 0).reduce((sum, x) => sum + x.availableMinutes, 0)),
            activeLines: active.length,
            belowTargetLines: belowTarget,
            configuredLines: active.filter(x => x.dailyTarget > 0 && x.smv > 0 && x.manpower > 0).length,
            bestLine: ranked.length ? { line: ranked[0].line, achievement: currentHour ? ranked[0].paceAchievement : ranked[0].achievement } : null,
            worstLine: ranked.length ? { line: ranked[ranked.length - 1].line, achievement: currentHour ? ranked[ranked.length - 1].paceAchievement : ranked[ranked.length - 1].achievement } : null,
            currentHour
        },
        hourly,
        lines: lineList
    };
    cache.put(cacheKey, JSON.stringify(response), 8);
    return response;
}

function enterpriseGetQuality(dateString) {
    const ss = ctSpreadsheet_();
    const tz = ss.getSpreadsheetTimeZone() || 'Asia/Dhaka';
    const dateKey = ctDateKeyFromInput_(dateString, tz);
    const cache = CacheService.getScriptCache();
    const versionNow = PropertiesService.getScriptProperties().getProperty(CT_CONFIG.POLL_VERSION_KEY) || '1';
    const cacheKey = 'ct_quality_' + dateKey + '_' + versionNow;
    const cached = cache.get(cacheKey);
    if (cached) return JSON.parse(cached);
    const sh = ss.getSheetByName(CT_CONFIG.QUALITY_SHEET);
    const configs = ctLineRows_();
    const byLine = {};
    for (let n = 1; n <= 14; n++) byLine[n] = { line: n, checked: 0, pass: 0, defect: 0, passRate: 0, dhu: 0, dhuTarget: configs[n].dhuTarget, status: 'NO DATA' };
    const defects = {};
    let totalChecked = 0, totalPass = 0, totalDefect = 0, latestMs = 0;
    if (sh && sh.getLastRow() >= 2) {
        const rows = sh.getRange(2, 1, sh.getLastRow() - 1, Math.max(11, sh.getLastColumn())).getValues();
        rows.forEach(r => {
            if (!r[0] || ctDateKey_(r[0], tz) !== dateKey) return;
            const line = Number(r[2]);
            if (!byLine[line]) return;
            const checked = Number(r[6]) || 0, pass = Number(r[7]) || 0, defect = Number(r[8]) || 0;
            byLine[line].checked += checked; byLine[line].pass += pass; byLine[line].defect += defect;
            totalChecked += checked; totalPass += pass; totalDefect += defect;
            const name = String(r[10] || r[9] || 'Unspecified defect').trim() || 'Unspecified defect';
            if (defect > 0) defects[name] = (defects[name] || 0) + defect;
            const stamp = ctCombineDateTime_(r[0], r[1]);
            if (stamp && stamp.getTime() > latestMs) latestMs = stamp.getTime();
        });
    }
    const lines = Object.values(byLine).map(x => {
        x.passRate = x.checked > 0 ? x.pass / x.checked * 100 : 0;
        x.dhu = x.checked > 0 ? x.defect / x.checked * 100 : 0;
        x.status = x.checked <= 0 ? 'NO DATA' : (x.dhuTarget > 0 ? (x.dhu <= x.dhuTarget ? 'GOOD' : 'ACTION') : 'NO TARGET');
        return x;
    });
    const topDefects = Object.keys(defects).map(name => ({ name, pcs: defects[name] })).sort((a, b) => b.pcs - a.pcs).slice(0, 8);
    const response = {
        date: dateKey,
        timestamp: new Date().toISOString(),
        lastUpdated: PropertiesService.getScriptProperties().getProperty(CT_CONFIG.LAST_UPDATED_KEY) || (latestMs ? new Date(latestMs).toISOString() : null),
        dataVersion: PropertiesService.getScriptProperties().getProperty(CT_CONFIG.POLL_VERSION_KEY) || '1',
        kpis: { checked: totalChecked, pass: totalPass, defect: totalDefect, passRate: totalChecked ? totalPass / totalChecked * 100 : 0, dhu: totalChecked ? totalDefect / totalChecked * 100 : 0, linesWithData: lines.filter(x => x.checked > 0).length, actionLines: lines.filter(x => x.status === 'ACTION').length },
        lines,
        topDefects
    };
    cache.put(cacheKey, JSON.stringify(response), 12);
    return response;
}

function enterpriseSaveProduction(payload) {
    const line = Number(payload.line), hour = Number(payload.hour), pcs = Number(payload.pcs);
    if (!Number.isInteger(line) || line < 1 || line > 14) throw new Error('Line must be between 1 and 14.');
    if (!Number.isInteger(hour) || hour < 1 || hour > 11) throw new Error('Hour must be between 1 and 11.');
    if (!isFinite(pcs) || pcs < 0) throw new Error('PCS must be zero or a positive number.');
    const ss = ctSpreadsheet_(), sh = ss.getSheetByName(CT_CONFIG.INPUT_SHEET);
    if (!sh) throw new Error('INPUT sheet not found.');
    const id = String(payload.requestId || Utilities.getUuid());
    const lock = LockService.getScriptLock(); lock.waitLock(10000);
    try {
        if (ctIsDuplicate_(sh, CT_CONFIG.INPUT_REQUEST_ID_COL, id)) return { saved: true, duplicate: true, requestId: id };
        const cfg = ctLineRows_()[line];
        const date = ctParseDate_(payload.date, ss.getSpreadsheetTimeZone() || 'Asia/Dhaka');
        const now = new Date();
        const row = [date, now, line, hour, String(payload.buyer || cfg.buyer || '').trim(), String(payload.style || cfg.style || '').trim(), String(payload.po || cfg.po || '').trim(), String(payload.color || cfg.color || '').trim(), pcs, id];
        sh.getRange(sh.getLastRow() + 1, 1, 1, row.length).setValues([row]);
        ctCacheRequest_(id);
        ctAudit_('PRODUCTION INPUT', line, hour, pcs, id, payload.user || 'Vercel', payload.remark || '');
        ctAfterWrite_();
        return { saved: true, duplicate: false, requestId: id, savedAt: now.toISOString(), dataVersion: PropertiesService.getScriptProperties().getProperty(CT_CONFIG.POLL_VERSION_KEY) };
    } finally { lock.releaseLock(); }
}

function enterpriseSaveQuality(payload) {
    const line = Number(payload.line), checked = Number(payload.checked), pass = Number(payload.pass), defect = Number(payload.defect);
    if (!Number.isInteger(line) || line < 1 || line > 14) throw new Error('Line must be between 1 and 14.');
    if (![checked, pass, defect].every(x => isFinite(x) && x >= 0)) throw new Error('Checked, pass and defect must be non-negative numbers.');
    if (pass > checked) throw new Error('Pass PCS cannot exceed checked PCS. Defect count is recorded separately for DHU.');
    const ss = ctSpreadsheet_(), sh = ss.getSheetByName(CT_CONFIG.QUALITY_SHEET);
    if (!sh) throw new Error('QUALITY INPUT sheet not found.');
    const id = String(payload.requestId || Utilities.getUuid());
    const lock = LockService.getScriptLock(); lock.waitLock(10000);
    try {
        if (ctIsDuplicate_(sh, CT_CONFIG.QUALITY_REQUEST_ID_COL, id)) return { saved: true, duplicate: true, requestId: id };
        const cfg = ctLineRows_()[line], date = ctParseDate_(payload.date, ss.getSpreadsheetTimeZone() || 'Asia/Dhaka'), now = new Date();
        const row = [date, now, line, String(payload.buyer || cfg.buyer || '').trim(), String(payload.style || cfg.style || '').trim(), String(payload.po || cfg.po || '').trim(), checked, pass, defect, String(payload.defectCode || '').trim(), String(payload.defectDescription || '').trim(), id];
        sh.getRange(sh.getLastRow() + 1, 1, 1, row.length).setValues([row]);
        ctCacheRequest_(id);
        ctAudit_('QUALITY INPUT', line, '', defect, id, payload.user || 'Vercel', payload.defectDescription || '');
        ctAfterWrite_();
        return { saved: true, duplicate: false, requestId: id, savedAt: now.toISOString(), dataVersion: PropertiesService.getScriptProperties().getProperty(CT_CONFIG.POLL_VERSION_KEY) };
    } finally { lock.releaseLock(); }
}

function enterpriseSaveTargets(payload) {
    if (!Array.isArray(payload.lines)) throw new Error('Target payload must contain a lines array.');
    const ss = ctSpreadsheet_(), sh = ss.getSheetByName(CT_CONFIG.LINE_SHEET);
    const byLine = {};
    payload.lines.forEach(x => { const n = Number(x.line); if (n >= 1 && n <= 14) byLine[n] = x; });
    const rows = [];
    const currentLines = ctLineRows_();
    for (let n = 1; n <= 14; n++) {
        const x = byLine[n] || {};
        const current = currentLines[n];

        // Preserve existing settings when the caller sends only a partial line list.
        const daily = x.dailyTarget !== undefined ? ctNum_(x.dailyTarget) : current.dailyTarget;
        const smv = x.smv !== undefined ? ctNum_(x.smv) : current.smv;
        const manpower = x.manpower !== undefined ? ctNum_(x.manpower) : current.manpower;
        const eff = x.efficiencyTarget !== undefined ? ctNum_(x.efficiencyTarget) : current.efficiencyTarget;
        const dhu = x.dhuTarget !== undefined ? ctNum_(x.dhuTarget) : current.dhuTarget;
        const work = x.workingMinutes !== undefined ? (ctNum_(x.workingMinutes) || CT_CONFIG.DEFAULT_WORK_MINUTES) : current.workingMinutes;
        const active = x.active !== undefined ? x.active !== false : current.active;
        const buyer = x.buyer !== undefined ? String(x.buyer || '') : current.buyer;
        const style = x.style !== undefined ? String(x.style || '') : current.style;
        const po = x.po !== undefined ? String(x.po || '') : current.po;
        const color = x.color !== undefined ? String(x.color || '') : current.color;

        let hours;
        if (Array.isArray(x.hourlyTargets)) {
            hours = x.hourlyTargets.slice(0, 11).map(v => v === '' || v == null ? '' : ctNum_(v));
        } else {
            hours = current.hasCustomHourlyTargets ? current.hourlyTargets.slice(0, 11) : Array(11).fill('');
        }
        while (hours.length < 11) hours.push('');
        rows.push([n, active, daily, smv, manpower, eff, dhu, work, buyer, style, po, color, ...hours]);
    }
    sh.getRange(2, 1, 14, 23).setValues(rows);
    ctAudit_('TARGET SETUP', '', '', '', String(payload.requestId || Utilities.getUuid()), payload.user || 'Vercel', 'Line targets / SMV / manpower updated');
    ctAfterWrite_();
    return { saved: true, lines: 14, dataVersion: PropertiesService.getScriptProperties().getProperty(CT_CONFIG.POLL_VERSION_KEY) };
}

function ctAfterWrite_() {
    const props = PropertiesService.getScriptProperties();
    props.setProperty(CT_CONFIG.LAST_UPDATED_KEY, new Date().toISOString());
    ctBumpVersion_();
    SpreadsheetApp.flush();
}

function enterpriseScheduledRefresh() {
    try {
        SpreadsheetApp.flush();
        if (typeof updateProductionDisplay === 'function') updateProductionDisplay();
        const props = PropertiesService.getScriptProperties();
        props.setProperty(CT_CONFIG.LAST_UPDATED_KEY, new Date().toISOString());
        ctBumpVersion_();
    } catch (err) { console.error('Scheduled Control Tower refresh failed: ' + err.message); }
}

function enterpriseHandleSheetEdit(e) {
    try {
        if (!e || !e.range) return;
        const name = e.range.getSheet().getName();
        if ([CT_CONFIG.INPUT_SHEET, CT_CONFIG.QUALITY_SHEET, CT_CONFIG.LINE_SHEET, CT_CONFIG.SETUP_SHEET].indexOf(name) < 0) return;
        const props = PropertiesService.getScriptProperties();
        props.setProperty(CT_CONFIG.LAST_UPDATED_KEY, new Date().toISOString());
        ctBumpVersion_();
        SpreadsheetApp.flush();
        try { if (typeof updateProductionDisplay === 'function') updateProductionDisplay(); } catch (err) { console.log(err.message); }
    } catch (err) { console.error('enterpriseHandleSheetEdit: ' + err.message); }
}

function ctBumpVersion_() {
    const p = PropertiesService.getScriptProperties();
    p.setProperty(CT_CONFIG.POLL_VERSION_KEY, String(Number(p.getProperty(CT_CONFIG.POLL_VERSION_KEY) || 0) + 1));
}

function ctIsDuplicate_(sheet, col, id) {
    const cache = CacheService.getScriptCache();
    if (cache.get('ct_req_' + id)) return true;
    const last = sheet.getLastRow();
    if (last >= 2 && sheet.getLastColumn() >= col) {
        const start = Math.max(2, last - 5000);
        const vals = sheet.getRange(start, col, last - start + 1, 1).getDisplayValues().flat();
        if (vals.indexOf(id) >= 0) { cache.put('ct_req_' + id, '1', 21600); return true; }
    }
    return false;
}

function ctCacheRequest_(id) { CacheService.getScriptCache().put('ct_req_' + id, '1', 21600); }

function ctAudit_(action, line, hour, qty, id, source, details) {
    const sh = ctSpreadsheet_().getSheetByName(CT_CONFIG.AUDIT_SHEET);
    if (sh) sh.appendRow([new Date(), action, line, hour, qty, id, source, details]);
}

function ctNum_(v) { const n = Number(v); return isFinite(n) && v !== '' && v != null ? n : 0; }

function ctDateKeyFromInput_(value, tz) {
    if (!value) return Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    const s = String(value).trim().slice(0, 10);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) throw new Error('Date must use YYYY-MM-DD.');
    const parts = s.split('-').map(Number);
    const check = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2]));
    if (check.getUTCFullYear() !== parts[0] || check.getUTCMonth() !== parts[1] - 1 || check.getUTCDate() !== parts[2]) {
        throw new Error('Invalid calendar date: ' + s);
    }
    return s;
}

function ctParseDate_(value, tz) {
    const key = ctDateKeyFromInput_(value, tz);
    // Parse in the spreadsheet timezone to avoid script/server timezone shifts.
    return Utilities.parseDate(key, tz, 'yyyy-MM-dd');
}

function ctDateKey_(value, tz) {
    if (value instanceof Date) return Utilities.formatDate(value, tz, 'yyyy-MM-dd');
    const d = new Date(value);
    if (!isNaN(d.getTime())) return Utilities.formatDate(d, tz, 'yyyy-MM-dd');
    return String(value).trim().slice(0, 10);
}

function ctCombineDateTime_(dateValue, timeValue) {
    if (!(dateValue instanceof Date)) return null;
    const d = new Date(dateValue.getTime());
    if (timeValue instanceof Date) d.setHours(timeValue.getHours(), timeValue.getMinutes(), timeValue.getSeconds(), 0);
    return d;
}
