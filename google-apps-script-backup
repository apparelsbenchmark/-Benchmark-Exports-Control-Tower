/***************************************************************
 * CLEAR TODAY'S PRODUCTION
 *
 * ONLY today's INPUT rows are removed.
 * Historical data remains.
 ***************************************************************/
function clearTodayProduction() {

    const ss =
        SpreadsheetApp
            .getActiveSpreadsheet();


    const sheet =
        ss.getSheetByName(
            CONFIG.INPUT_SHEET
        );


    if (
        !sheet ||
        sheet.getLastRow() < 2
    ) {
        return;
    }


    const timezone =
        ss.getSpreadsheetTimeZone() ||
        "Asia/Dhaka";


    const todayKey =
        Utilities.formatDate(
            new Date(),
            timezone,
            "yyyy-MM-dd"
        );


    const lastRow =
        sheet.getLastRow();


    const lastCol =
        Math.max(
            sheet.getLastColumn(),
            9
        );


    const data =
        sheet
            .getRange(
                2,
                1,
                lastRow - 1,
                lastCol
            )
            .getValues();


    const rowsToDelete = [];


    data.forEach(
        (row, index) => {

            if (!row[0]) {
                return;
            }


            const dateKey =
                getDateKey_(
                    row[0],
                    timezone
                );


            if (
                dateKey === todayKey
            ) {

                rowsToDelete.push(
                    index + 2
                );
            }
        }
    );


    /*
     * Delete bottom to top.
     */
    rowsToDelete
        .reverse()
        .forEach(row => {

            sheet.deleteRow(row);
        });


    updateProductionDisplay();
}


