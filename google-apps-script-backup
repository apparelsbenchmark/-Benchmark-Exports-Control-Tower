/***************************************************************
 * ENSURE SHEET SIZE
 ***************************************************************/
function ensureSheetSize_(
    sheet,
    rows,
    columns
) {

    if (
        sheet.getMaxRows() < rows
    ) {

        sheet.insertRowsAfter(
            sheet.getMaxRows(),
            rows -
            sheet.getMaxRows()
        );
    }


    if (
        sheet.getMaxColumns() < columns
    ) {

        sheet.insertColumnsAfter(
            sheet.getMaxColumns(),
            columns -
            sheet.getMaxColumns()
        );
    }
}




