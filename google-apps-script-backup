/** Run once from the spreadsheet's Apps Script editor. */
function setupEnterpriseControlTower() {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) {
        throw new Error('Open this Apps Script project from the target Google Sheet.');
    }

    // Bootstrap the original production workbook when one or more base tabs are absent.
    // createProductionSystem() is included earlier in this merged Code.gs file.
    const requiredBaseTabs = [
        CT_CONFIG.INPUT_SHEET,
        CT_CONFIG.QUALITY_SHEET,
        CT_CONFIG.SETUP_SHEET,
        'Benchmark Exports'
    ];
    const missingBaseTabs = requiredBaseTabs.filter(name => !ss.getSheetByName(name));

    if (missingBaseTabs.length) {
        if (typeof createProductionSystem !== 'function') {
            throw new Error(
                'Base production sheets are missing (' + missingBaseTabs.join(', ') +
                '). The original createProductionSystem() function must be included in Code.gs.'
            );
        }
        createProductionSystem();
    }

    const input = ss.getSheetByName(CT_CONFIG.INPUT_SHEET);
    const quality = ss.getSheetByName(CT_CONFIG.QUALITY_SHEET);
    const setup = ss.getSheetByName(CT_CONFIG.SETUP_SHEET);

    if (!input || !quality || !setup) {
        throw new Error('Could not initialize INPUT, QUALITY INPUT and SETUP. Check the original production-system functions.');
    }

    // Reapply the original non-destructive sheet repairs. These functions add
    // missing headers/formatting and preserve existing production records.
    if (typeof repairInputSheet_ === 'function') repairInputSheet_(input);
    if (typeof repairQualitySheet_ === 'function') repairQualitySheet_(quality);
    if (typeof repairSetupSheet_ === 'function') repairSetupSheet_(setup);

    // Ensure the expected base columns exist without clearing or moving existing records.
    ctEnsureBaseHeaders_(input, [
        'Date', 'Time', 'Line', 'Hour', 'Buyer',
        'Style', 'PO', 'Color', 'PCS'
    ]);
    ctEnsureBaseHeaders_(quality, [
        'Date', 'Time', 'Line', 'Buyer', 'Style', 'PO',
        'Checked PCS', 'Pass PCS', 'Defect PCS',
        'Defect Code', 'Defect Description'
    ]);

    // Request IDs are appended after the original columns for safe retry handling.
    ctEnsureHeader_(input, CT_CONFIG.INPUT_REQUEST_ID_COL, 'Request ID');
    ctEnsureHeader_(quality, CT_CONFIG.QUALITY_REQUEST_ID_COL, 'Request ID');

    const props = PropertiesService.getScriptProperties();
    props.setProperty(CT_CONFIG.SPREADSHEET_ID_KEY, ss.getId());

    // These functions create the support tabs if they are not already present.
    ctSetupLineMaster_(ss);
    ctSetupAudit_(ss);

    // Keep the existing API token so a routine setup does not unexpectedly break Vercel.
    let token = props.getProperty(CT_CONFIG.API_TOKEN_KEY);
    if (!token) {
        token = [Utilities.getUuid(), Utilities.getUuid(), Utilities.getUuid()]
            .join('')
            .replace(/-/g, '');
        props.setProperty(CT_CONFIG.API_TOKEN_KEY, token);
    }

    // Replace only this add-on's own triggers.
    ScriptApp.getProjectTriggers().forEach(trigger => {
        const handler = trigger.getHandlerFunction();
        if (
            handler === 'enterpriseScheduledRefresh' ||
            handler === 'enterpriseHandleSheetEdit'
        ) {
            ScriptApp.deleteTrigger(trigger);
        }
    });

    ScriptApp.newTrigger('enterpriseScheduledRefresh')
        .timeBased()
        .everyMinutes(5)
        .create();

    ScriptApp.newTrigger('enterpriseHandleSheetEdit')
        .forSpreadsheet(ss)
        .onEdit()
        .create();

    props.setProperty(CT_CONFIG.LAST_UPDATED_KEY, new Date().toISOString());
    ctBumpVersion_();
    SpreadsheetApp.flush();

    // Refresh the existing spreadsheet dashboard if its original function exists.
    if (typeof updateProductionDisplay === 'function') {
        try {
            updateProductionDisplay();
        } catch (err) {
            console.error('Original dashboard refresh failed: ' + err.message);
        }
    }

    SpreadsheetApp.getUi().alert(
        'CONTROL TOWER SETUP COMPLETE\n\n' +
        'INPUT: Ready\n' +
        'QUALITY INPUT: Ready\n' +
        'SETUP: Ready\n' +
        'LINE MASTER: Ready\n' +
        'CONTROL TOWER LOG: Ready\n\n' +
        'Automatic refresh: every 5 minutes\n' +
        'Vercel live sync: every 5 seconds\n\n' +
        'APPS_SCRIPT_TOKEN (keep private):\n\n' + token
    );
}

/** Add missing base headers while preserving all existing rows and values. */
function ctEnsureBaseHeaders_(sheet, headers) {
    const width = Math.max(sheet.getLastColumn(), headers.length);
    const existing = sheet.getRange(1, 1, 1, width).getDisplayValues()[0];

    headers.forEach((header, index) => {
        const current = String(existing[index] || '').trim();
        if (!current) {
            sheet.getRange(1, index + 1).setValue(header);
        } else if (current.toLowerCase() !== header.toLowerCase()) {
            throw new Error(
                'Header mismatch in sheet "' + sheet.getName() + '", column ' +
                (index + 1) + '. Expected "' + header + '" but found "' + current + '".'
            );
        }
    });

    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, headers.length)
        .setBackground('#10233f')
        .setFontColor('#ffffff')
        .setFontWeight('bold');
}

/** Optional token rotation. Run only if the current token is compromised. */
function rotateEnterpriseApiToken() {
    const token = [Utilities.getUuid(), Utilities.getUuid(), Utilities.getUuid()].join('-').replace(/-/g, '');
    PropertiesService.getScriptProperties().setProperty(CT_CONFIG.API_TOKEN_KEY, token);
