/***************************************************************
 * KPI CARD
 ***************************************************************/
function createKpiCard_(
    sheet,
    labelRange,
    valueRange,
    label
) {

    sheet
        .getRange(labelRange)
        .merge()
        .setValue(label)
        .setBackground("#1E3A5F")
        .setFontColor("#CBD5E1")
        .setFontSize(9)
        .setFontWeight("bold")
        .setHorizontalAlignment("center")
        .setVerticalAlignment("middle");


    sheet
        .getRange(valueRange)
        .merge()
        .setValue("-")
        .setBackground("#172033")
        .setFontColor("#FFFFFF")
        .setFontSize(17)
        .setFontWeight("bold")
        .setHorizontalAlignment("center")
        .setVerticalAlignment("middle");
}


/***************************************************************
 * FILTER DROPDOWNS
 ***************************************************************/
function setFilterValidation_(sheet) {

    const ss =
        SpreadsheetApp.getActiveSpreadsheet();

    const input =
        ss.getSheetByName(
            CONFIG.INPUT_SHEET
        );

    if (!input) return;

    const lastRow =
        input.getLastRow();

    if (lastRow < 2) return;

    const data =
        input
            .getRange(
                2,
                1,
                lastRow - 1,
                9
            )
            .getValues();


    const buyers = new Set();
    const styles = new Set();
    const pos = new Set();
    const colors = new Set();


    data.forEach(row => {

        if (row[4]) {
            buyers.add(
                String(row[4]).trim()
            );
        }

        if (row[5]) {
            styles.add(
                String(row[5]).trim()
            );
        }

        if (row[6]) {
            pos.add(
                String(row[6]).trim()
            );
        }

        if (row[7]) {
            colors.add(
                String(row[7]).trim()
            );
        }
    });


    createDropdown_(
        sheet,
        "B2",
        ["ALL"].concat(
            Array.from(buyers).sort()
        )
    );


    createDropdown_(
        sheet,
        "E2",
        ["ALL"].concat(
            Array.from(styles).sort()
        )
    );


    createDropdown_(
        sheet,
        "H2",
        ["ALL"].concat(
            Array.from(pos).sort()
        )
    );


    createDropdown_(
        sheet,
        "K2",
        ["ALL"].concat(
            Array.from(colors).sort()
        )
    );
}


/***************************************************************
 * CREATE DROPDOWN
 ***************************************************************/
function createDropdown_(
    sheet,
    cell,
    values
) {

    const rule =
        SpreadsheetApp.newDataValidation()
            .requireValueInList(
                values,
                true
            )
            .setAllowInvalid(true)
            .build();

    sheet
        .getRange(cell)
        .setDataValidation(rule);
}


/***************************************************************
 * MAIN UPDATE
 ***************************************************************/
function updateProductionDisplay() {

    const ss =
        SpreadsheetApp.getActiveSpreadsheet();

    const input =
        ss.getSheetByName(
            CONFIG.INPUT_SHEET
        );

    const quality =
        ss.getSheetByName(
            CONFIG.QUALITY_SHEET
        );

    const setup =
        ss.getSheetByName(
            CONFIG.SETUP_SHEET
        );

    const display =
        ss.getSheetByName(
            CONFIG.DISPLAY_SHEET
        );


    if (!input || !setup || !display) {
        return;
    }


    const timezone =
        ss.getSpreadsheetTimeZone() ||
        "Asia/Dhaka";


    /*************************************************************
     * SELECTED DATE
     *************************************************************/
    let selectedDate =
        display
            .getRange("N2")
            .getValue();


    if (!(selectedDate instanceof Date)) {

        selectedDate =
            new Date();

        display
            .getRange("N2")
            .setValue(selectedDate);
    }


    const selectedDateKey =
        Utilities.formatDate(
            selectedDate,
            timezone,
            "yyyy-MM-dd"
        );


    /*************************************************************
     * FILTERS
     *************************************************************/
    const buyerFilter =
        String(
            display
                .getRange("B2")
                .getValue() ||
            "ALL"
        );


    const styleFilter =
        String(
            display
                .getRange("E2")
                .getValue() ||
            "ALL"
        );


    const poFilter =
        String(
            display
                .getRange("H2")
                .getValue() ||
            "ALL"
        );


    const colorFilter =
        String(
            display
                .getRange("K2")
                .getValue() ||
            "ALL"
        );


    /*************************************************************
     * PLANS
     *************************************************************/
    const hourlyPlans =
        getHourlyPlans_(setup);


    const cumulativePlans = [];

    let runningPlan = 0;

    hourlyPlans.forEach(plan => {

        runningPlan += plan;

        cumulativePlans.push(
            runningPlan
        );
    });


    const dailyPlan =
        hourlyPlans.reduce(
            (a, b) => a + b,
            0
        );


    /*************************************************************
     * PRODUCTION
     *************************************************************/
    const production =
        getProductionData_(
            input,
            timezone,
            selectedDateKey,
            buyerFilter,
            styleFilter,
            poFilter,
            colorFilter
        );


    /*************************************************************
     * MAIN LINE TABLE
     *************************************************************/
    const dashboardRows = [];

    const lineTotals = [];


    for (
        let line = 1;
        line <= CONFIG.NUMBER_OF_LINES;
        line++
    ) {

        const lineData =
            production[line] || {
                hours:
                    Array(
                        CONFIG.NUMBER_OF_HOURS
                    ).fill(0),

                buyers: new Set(),
                styles: new Set()
            };


        const row = [];


        /*
         * Line.
         */
        row.push(
            line + "."
        );


        /*
         * Buyer.
         */
        row.push(
            formatSet_(
                lineData.buyers
            )
        );


        /*
         * Style.
         */
        row.push(
            formatSet_(
                lineData.styles
            )
        );


        /*
         * Hourly production.
         */
        let total = 0;

        for (
            let h = 0;
            h < CONFIG.NUMBER_OF_HOURS;
            h++
        ) {

            const pcs =
                Number(
                    lineData.hours[h] || 0
                );

            row.push(pcs);

            total += pcs;
        }


        /*
         * Daily achievement.
         */
        const achievement =
            dailyPlan > 0
                ? total / dailyPlan
                : 0;


        /*
         * Quality.
         */
        const q =
            getLineQuality_(
                quality,
                line,
                timezone,
                selectedDateKey,
                buyerFilter,
                styleFilter,
                poFilter
            );


        const qualityPercent =
            q.checked > 0
                ? q.pass / q.checked
                : 0;


        const dhu =
            q.checked > 0
                ? q.defect / q.checked
                : 0;


        row.push(total);
        row.push(achievement);
        row.push(qualityPercent);
        row.push(dhu);


        dashboardRows.push(row);

        lineTotals.push(total);
    }


    /*************************************************************
     * WRITE MAIN TABLE
     *************************************************************/
    display
        .getRange(
            CONFIG.FIRST_LINE_ROW,
            1,
            CONFIG.NUMBER_OF_LINES,
            CONFIG.TOTAL_COLUMNS
        )
        .setValues(dashboardRows);


    /*
     * Number formats.
     */
    display
        .getRange(
            CONFIG.FIRST_LINE_ROW,
            4,
            CONFIG.NUMBER_OF_LINES,
            12
        )
        .setNumberFormat("#,##0");


    display
        .getRange(
            CONFIG.FIRST_LINE_ROW,
            16,
            CONFIG.NUMBER_OF_LINES,
            3
        )
        .setNumberFormat("0.0%");


    /*************************************************************
     * PRODUCTION COLORS
     *************************************************************/
    formatProductionCells_(
        display,
        production,
        hourlyPlans
    );


    /*************************************************************
     * HOURLY TOTALS
     *************************************************************/
    const hourlyActual =
        Array(
            CONFIG.NUMBER_OF_HOURS
        ).fill(0);


    for (
        let line = 1;
        line <= CONFIG.NUMBER_OF_LINES;
        line++
    ) {

        const lineData =
            production[line];

        if (!lineData) continue;


        for (
            let h = 0;
            h < CONFIG.NUMBER_OF_HOURS;
            h++
        ) {

            hourlyActual[h] +=
                Number(
                    lineData.hours[h] || 0
                );
        }
    }


    /*************************************************************
     * CUMULATIVE ACTUAL
     *************************************************************/
    const cumulativeActual = [];

    let runningActual = 0;

    hourlyActual.forEach(value => {

        runningActual += value;

        cumulativeActual.push(
            runningActual
        );
    });


    /*************************************************************
     * VARIANCES
     *************************************************************/
    const variancePCS = [];
    const varianceHrs = [];


    for (
        let h = 0;
        h < CONFIG.NUMBER_OF_HOURS;
        h++
    ) {

        const variance =
            hourlyActual[h] -
            hourlyPlans[h];


        variancePCS.push(
            variance
        );


        const varianceHour =
            hourlyPlans[h] > 0
                ? variance / hourlyPlans[h]
                : 0;


        varianceHrs.push(
            varianceHour
        );
    }


    /*************************************************************
     * SUMMARY ROWS
     *************************************************************/
    const summaryRows = [
        hourlyPlans,
        hourlyActual,
        cumulativePlans,
        hourlyPlans,
        variancePCS,
        varianceHrs
    ];


    display
        .getRange(
            CONFIG.HOURLY_PLAN_ROW,
            4,
            6,
            CONFIG.NUMBER_OF_HOURS
        )
        .setValues(summaryRows);


    /*
     * Summary totals.
     */
    display
        .getRange(
            CONFIG.HOURLY_PLAN_ROW,
            15
        )
        .setValue(dailyPlan);


    display
        .getRange(
            CONFIG.CUM_ACTUAL_ROW,
            15
        )
        .setValue(
            runningActual
        );


    display
        .getRange(
            CONFIG.CUM_PLAN_ROW,
            15
        )
        .setValue(
            dailyPlan
        );


    display
        .getRange(
            CONFIG.DAILY_PLAN_ROW,
            15
        )
        .setValue(
            dailyPlan
        );


    display
        .getRange(
            CONFIG.VARIANCE_PCS_ROW,
            15
        )
        .setValue(
            runningActual - dailyPlan
        );


    const totalVarianceHrs =
        varianceHrs.reduce(
            (a, b) => a + b,
            0
        );


    display
        .getRange(
            CONFIG.VARIANCE_HRS_ROW,
            15
        )
        .setValue(
            totalVarianceHrs
        );


    /*************************************************************
     * QUALITY TOTAL
     *************************************************************/
    const qualityTotal =
        getTotalQuality_(
            quality,
            timezone,
            selectedDateKey,
            buyerFilter,
            styleFilter,
            poFilter
        );


    const qualityPercent =
        qualityTotal.checked > 0
            ? qualityTotal.pass /
            qualityTotal.checked
            : 0;


    const dhu =
        qualityTotal.checked > 0
            ? qualityTotal.defect /
            qualityTotal.checked
            : 0;


    /*************************************************************
     * ACHIEVEMENT
     *************************************************************/
    const achievement =
        dailyPlan > 0
            ? runningActual / dailyPlan
            : 0;


    /*************************************************************
     * EQUIVALENT CUM HOURS
     *************************************************************/
    const averageHourlyPlan =
        hourlyPlans.length > 0
            ? dailyPlan /
            hourlyPlans.length
            : 0;


    const cumHours =
        averageHourlyPlan > 0
            ? runningActual /
            averageHourlyPlan
            : 0;


    /*************************************************************
     * EFFICIENCY
     *
     * If actual efficiency exists in SETUP, use it.
     * Otherwise use achievement as operational indicator.
     *************************************************************/
    let efficiency =
        Number(
            setup.getRange("E5").getValue()
        ) || 0;


    /*
     * Display efficiency as percentage.
     *
     * E5 is stored as 55 for 55%.
     */
    efficiency =
        efficiency / 100;


    /*
     * If there is actual production,
     * achievement is shown as the live operational
     * efficiency indicator.
     *
     * This avoids falsely claiming that PCS/plan is
     * the true SMV efficiency.
     */
    if (runningActual > 0) {
        efficiency = achievement;
    }


    /*************************************************************
     * KPI VALUES
     *************************************************************/
    setKpiValue_(
        display,
        "A4:B4",
        dailyPlan,
        "#,##0"
    );


    setKpiValue_(
        display,
        "C4:D4",
        runningActual,
        "#,##0"
    );


    setKpiValue_(
        display,
        "E4:F4",
        achievement,
        "0.0%"
    );


    setKpiValue_(
        display,
        "G4:H4",
        efficiency,
        "0.0%"
    );


    setKpiValue_(
        display,
        "I4:J4",
        qualityPercent,
        "0.0%"
    );


    setKpiValue_(
        display,
        "K4:L4",
        dhu,
        "0.0%"
    );


    setKpiValue_(
        display,
        "M4:N4",
        qualityTotal.defect,
        "#,##0"
    );


    setKpiValue_(
        display,
        "O4:P4",
        cumHours,
        "0.0"
    );


    setKpiValue_(
        display,
        "Q4:R4",
        runningActual - dailyPlan,
        "#,##0"
    );


    /*************************************************************
     * QUALITY SECTION
     *************************************************************/
    updateQualitySection_(
        display,
        quality,
        timezone,
        selectedDateKey,
        buyerFilter,
        styleFilter,
        poFilter
    );


    /*************************************************************
     * SUMMARY FORMAT
     *************************************************************/
    formatSummary_(
        display
    );


    /*************************************************************
     * UPDATE FILTERS
     *************************************************************/
    setFilterValidation_(
        display
    );
}


/***************************************************************
 * GET HOURLY PLANS
 ***************************************************************/
function getHourlyPlans_(setup) {

    const plans = [];


    for (
        let i = 0;
        i < CONFIG.NUMBER_OF_HOURS;
        i++
    ) {

        const value =
            Number(
                setup
                    .getRange(
                        2 + i,
                        2
                    )
                    .getValue()
            ) || 0;


        plans.push(value);
    }


    return plans;
}


/***************************************************************
 * GET PRODUCTION DATA
 ***************************************************************/
function getProductionData_(
    sheet,
    timezone,
    selectedDateKey,
    buyerFilter,
    styleFilter,
    poFilter,
    colorFilter
) {

    const result = {};


    /*
     * Create all 14 lines.
     */
    for (
        let line = 1;
        line <= CONFIG.NUMBER_OF_LINES;
        line++
    ) {

        result[line] = {

            hours:
                Array(
                    CONFIG.NUMBER_OF_HOURS
                ).fill(0),

            buyers:
                new Set(),

            styles:
                new Set()
        };
    }


    const lastRow =
        sheet.getLastRow();


    if (lastRow < 2) {
        return result;
    }


    const lastCol =
        Math.max(
            sheet.getLastColumn(),
            9
        );


    const data =
        sheet
            .getRange(
                2,
                1,
                lastRow - 1,
                lastCol
            )
            .getValues();


    data.forEach(row => {

        if (!row[0]) return;


        /*
         * Date.
         */
        const dateKey =
            getDateKey_(
                row[0],
                timezone
            );


        if (
            dateKey !==
            selectedDateKey
        ) {
            return;
        }


        /*
         * Line.
         */
        const line =
            Number(row[2]);


        if (
            !line ||
            line < 1 ||
            line > CONFIG.NUMBER_OF_LINES
        ) {
            return;
        }


        /*
         * Hour.
         */
        const hour =
            Number(row[3]);


        if (
            !hour ||
            hour < 1 ||
            hour > CONFIG.NUMBER_OF_HOURS
        ) {
            return;
        }


        const buyer =
            String(
                row[4] || ""
            ).trim();


        const style =
            String(
                row[5] || ""
            ).trim();


        const po =
            String(
                row[6] || ""
            ).trim();


        const color =
            String(
                row[7] || ""
            ).trim();


        const pcs =
            Number(row[8]) || 0;


        /*
         * Filters.
         */
        if (
            buyerFilter !== "ALL" &&
            buyer !== buyerFilter
        ) {
            return;
        }


        if (
            styleFilter !== "ALL" &&
            style !== styleFilter
        ) {
            return;
        }


        if (
            poFilter !== "ALL" &&
            po !== poFilter
        ) {
            return;
        }


        if (
            colorFilter !== "ALL" &&
            color !== colorFilter
        ) {
            return;
        }


        /*
         * IMPORTANT:
         *
         * Same Line + Hour entries
         * are automatically summed.
         */
        result[line]
            .hours[hour - 1] += pcs;


        if (buyer) {
            result[line]
                .buyers
                .add(buyer);
        }


        if (style) {
            result[line]
                .styles
                .add(style);
        }
    });


    return result;
}


/***************************************************************
 * DATE KEY
 ***************************************************************/
function getDateKey_(
    value,
    timezone
) {

    if (value instanceof Date) {

        return Utilities.formatDate(
            value,
            timezone,
            "yyyy-MM-dd"
        );
    }


    /*
     * Try to parse text date.
     */
    const parsed =
        new Date(value);


    if (
        !isNaN(
            parsed.getTime()
        )
    ) {

        return Utilities.formatDate(
            parsed,
            timezone,
            "yyyy-MM-dd"
        );
    }


    return String(value).trim();
}


/***************************************************************
 * FORMAT SET
 ***************************************************************/
function formatSet_(set) {

    if (
        !set ||
        set.size === 0
    ) {
        return "-";
    }


    const values =
        Array.from(set);


    if (
        values.length === 1
    ) {
        return values[0];
    }


    /*
     * Avoid overcrowding TV screen.
     */
    return "MULTI";
}


/***************************************************************
 * PRODUCTION CELL COLORS
 ***************************************************************/
function formatProductionCells_(
    display,
    production,
    hourlyPlans
) {

    for (
        let line = 1;
        line <= CONFIG.NUMBER_OF_LINES;
        line++
    ) {

        const row =
            CONFIG.FIRST_LINE_ROW +
            line -
            1;


        const lineData =
            production[line];


        for (
            let h = 0;
            h < CONFIG.NUMBER_OF_HOURS;
            h++
        ) {

            const col =
                4 + h;


            const cell =
                display
                    .getRange(
                        row,
                        col
                    );


            const actual =
                lineData
                    ? Number(
                        lineData.hours[h] || 0
                    )
                    : 0;


            const plan =
                Number(
                    hourlyPlans[h] || 0
                );


            /*
             * No production.
             */
            if (actual === 0) {

                cell
                    .setBackground("#334155")
                    .setFontColor("#CBD5E1");


                /*
                 * Target achieved.
                 */
            } else if (
                actual >= plan
            ) {

                cell
                    .setBackground("#059669")
                    .setFontColor("#FFFFFF");


                /*
                 * Below target.
                 */
            } else {

                cell
                    .setBackground("#D65A86")
                    .setFontColor("#FFFFFF");
            }


            cell
                .setFontSize(13)
                .setFontWeight("bold")
                .setHorizontalAlignment("center")
                .setVerticalAlignment("middle");
        }


        /*
         * PCS total.
         */
        display
            .getRange(
                row,
                15
            )
            .setBackground("#2563EB")
            .setFontColor("#FFFFFF")
            .setFontWeight("bold");


        /*
         * Achievement.
         */
        const total =
            lineData
                ? lineData.hours.reduce(
                    (a, b) => a + b,
                    0
                )
                : 0;


        const dailyPlan =
            hourlyPlans.reduce(
                (a, b) => a + b,
                0
            );


        const achievement =
            dailyPlan > 0
                ? total / dailyPlan
                : 0;


        const achCell =
            display
                .getRange(
                    row,
                    16
                );


        if (
            achievement >= 1
        ) {

            achCell
                .setBackground("#059669")
                .setFontColor("#FFFFFF");


        } else if (
            achievement >= 0.9
        ) {

            achCell
                .setBackground("#D97706")
                .setFontColor("#FFFFFF");


        } else {

            achCell
                .setBackground("#DC2626")
                .setFontColor("#FFFFFF");
        }


        achCell
            .setFontWeight("bold");


        /*
         * Quality / DHU are formatted separately,
         * but give them a neutral base.
         */
        display
            .getRange(
                row,
                17,
                1,
                2
            )
            .setBackground("#1E293B")
            .setFontColor("#FFFFFF")
            .setFontWeight("bold");
    }
}


/***************************************************************
 * GET LINE QUALITY
 ***************************************************************/
function getLineQuality_(
    sheet,
    lineNumber,
    timezone,
    selectedDateKey,
    buyerFilter,
    styleFilter,
    poFilter
) {

    const result = {

        checked: 0,
        pass: 0,
        defect: 0
    };


    if (!sheet) {
        return result;
    }


    const lastRow =
        sheet.getLastRow();


    if (lastRow < 2) {
        return result;
    }


    const lastCol =
        Math.max(
            sheet.getLastColumn(),
            11
        );


    const data =
        sheet
            .getRange(
                2,
                1,
                lastRow - 1,
                lastCol
            )
            .getValues();


    data.forEach(row => {

        if (!row[0]) return;


        const dateKey =
            getDateKey_(
                row[0],
                timezone
            );


        if (
            dateKey !==
            selectedDateKey
        ) {
            return;
        }


        if (
            Number(row[2]) !==
            lineNumber
        ) {
            return;
        }


        const buyer =
            String(
                row[3] || ""
            ).trim();


        const style =
            String(
                row[4] || ""
            ).trim();


        const po =
            String(
                row[5] || ""
            ).trim();


        if (
            buyerFilter !== "ALL" &&
            buyer !== buyerFilter
        ) {
            return;
        }


        if (
            styleFilter !== "ALL" &&
            style !== styleFilter
        ) {
            return;
        }


        if (
            poFilter !== "ALL" &&
            po !== poFilter
        ) {
            return;
        }


        result.checked +=
            Number(row[6]) || 0;


        result.pass +=
            Number(row[7]) || 0;


        result.defect +=
            Number(row[8]) || 0;
    });


    return result;
}


