/***************************************************************
 * SETUP SHEET
 ***************************************************************/
function repairSetupSheet_(sheet) {

    /*
     * If the setup is empty, create it.
     *
     * Existing setup values are preserved.
     */
    if (sheet.getLastRow() === 0) {

        sheet.getRange("A1:B12").setValues([
            ["HOURLY PLAN", "PCS"],
            ["Hour 1", 147],
            ["Hour 2", 126],
            ["Hour 3", 128],
            ["Hour 4", 118],
            ["Hour 5", 115],
            ["Hour 6", 138],
            ["Hour 7", 65],
            ["Hour 8", 79],
            ["Hour 9", 59],
            ["Hour 10", 79],
            ["Hour 11", 49]
        ]);


        sheet.getRange("D1:E5").setValues([
            ["SETTING", "VALUE"],
            ["Daily Plan", ""],
            ["Plan Hrs", 956],
            ["TMs", 174],
            ["Efficiency Target", 55]
        ]);


        sheet.getRange("G1:H2").setValues([
            ["STATUS", "VALUE"],
            ["Factory", "BENCHMARK EXPORTS"]
        ]);
    }


    /*
     * Make sure hourly plans exist.
     */
    const defaultPlans = [
        147,
        126,
        128,
        118,
        115,
        138,
        65,
        79,
        59,
        79,
        49
    ];


    for (
        let i = 0;
        i < CONFIG.NUMBER_OF_HOURS;
        i++
    ) {

        const cell =
            sheet.getRange(2 + i, 2);

        if (
            cell.getValue() === "" ||
            cell.getValue() === null
        ) {

            cell.setValue(
                defaultPlans[i]
            );
        }
    }


    /*
     * Daily Plan formula.
     */
    sheet
        .getRange("E2")
        .setFormula("=SUM(B2:B12)");


    /*
     * Plan Hrs.
     */
    if (
        sheet.getRange("E3").getValue() === "" ||
        sheet.getRange("E3").getValue() === null
    ) {

        sheet
            .getRange("E3")
            .setValue(956);
    }


    /*
     * TMs.
     */
    if (
        sheet.getRange("E4").getValue() === "" ||
        sheet.getRange("E4").getValue() === null
    ) {

        sheet
            .getRange("E4")
            .setValue(174);
    }


    /*
     * Efficiency Target.
     */
    if (
        sheet.getRange("E5").getValue() === "" ||
        sheet.getRange("E5").getValue() === null
    ) {

        sheet
            .getRange("E5")
            .setValue(55);
    }


    /*
     * Cumulative plan.
     */
    sheet
        .getRange("G4:H4")
        .setValues([
            ["HOUR", "CUM PLAN"]
        ]);

    let runningPlan = 0;

    for (
        let i = 0;
        i < CONFIG.NUMBER_OF_HOURS;
        i++
    ) {

        runningPlan +=
            Number(
                sheet.getRange(2 + i, 2).getValue()
            ) || 0;

        sheet
            .getRange(5 + i, 7, 1, 2)
            .setValues([
                [
                    "H" + (i + 1),
                    runningPlan
                ]
            ]);
    }


    formatHeader_(
        sheet.getRange("A1:B1")
    );

    formatHeader_(
        sheet.getRange("D1:E1")
    );

    formatHeader_(
        sheet.getRange("G4:H4")
    );


    sheet.autoResizeColumns(1, 8);
}


