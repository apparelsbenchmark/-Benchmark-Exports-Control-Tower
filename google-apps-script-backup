/***************************************************************
 * QUALITY SECTION
 ***************************************************************/
function updateQualitySection_(
    display,
    sheet,
    timezone,
    selectedDateKey,
    buyerFilter,
    styleFilter,
    poFilter
) {

    /*
     * Clear old quality data only.
     */
    display
        .getRange(
            CONFIG.QUALITY_FIRST_ROW,
            1,
            14,
            12
        )
        .clearContent();


    if (
        !sheet ||
        sheet.getLastRow() < 2
    ) {

        display
            .getRange("A32")
            .setValue(
                "No quality data entered"
            )
            .setFontColor("#94A3B8");

        return;
    }


    /*************************************************************
     * LINE QUALITY
     *************************************************************/
    const rows = [];


    for (
        let line = 1;
        line <= CONFIG.NUMBER_OF_LINES;
        line++
    ) {

        const q =
            getLineQuality_(
                sheet,
                line,
                timezone,
                selectedDateKey,
                buyerFilter,
                styleFilter,
                poFilter
            );


        const qualityPercent =
            q.checked > 0
                ? q.pass / q.checked
                : 0;


        const dhu =
            q.checked > 0
                ? q.defect / q.checked
                : 0;


        let status =
            "NO DATA";


        if (q.checked > 0) {

            if (dhu <= 0.02) {

                status = "GOOD";

            } else if (dhu <= 0.04) {

                status = "WATCH";

            } else {

                status = "ACTION";
            }
        }


        rows.push([
            "L" +
            String(line)
                .padStart(2, "0"),

            q.checked,
            q.pass,
            q.defect,
            qualityPercent,
            dhu,
            status,
            ""
        ]);
    }


    /*************************************************************
     * QUALITY RANK
     *************************************************************/
    const ranked =
        rows
            .map((row, index) => {

                return {
                    index: index,
                    dhu: row[5],
                    checked: row[1]
                };
            })
            .filter(x =>
                x.checked > 0
            )
            .sort(
                (a, b) =>
                    a.dhu - b.dhu
            );


    ranked.forEach(
        (item, index) => {

            rows[item.index][7] =
                index + 1;
        }
    );


    /*************************************************************
     * WRITE QUALITY TABLE
     *************************************************************/
    display
        .getRange(
            CONFIG.QUALITY_FIRST_ROW,
            1,
            rows.length,
            8
        )
        .setValues(rows);


    display
        .getRange(
            CONFIG.QUALITY_FIRST_ROW,
            2,
            rows.length,
            3
        )
        .setNumberFormat("#,##0");


    display
        .getRange(
            CONFIG.QUALITY_FIRST_ROW,
            5,
            rows.length,
            2
        )
        .setNumberFormat("0.0%");


    display
        .getRange(
            CONFIG.QUALITY_FIRST_ROW,
            1,
            rows.length,
            8
        )
        .setHorizontalAlignment("center");


    /*************************************************************
     * QUALITY STATUS COLORS
     *************************************************************/
    for (
        let i = 0;
        i < rows.length;
        i++
    ) {

        const row =
            CONFIG.QUALITY_FIRST_ROW +
            i;


        const status =
            rows[i][6];


        const cell =
            display.getRange(
                row,
                7
            );


        if (
            status === "GOOD"
        ) {

            cell
                .setBackground("#059669")
                .setFontColor("#FFFFFF");


        } else if (
            status === "WATCH"
        ) {

            cell
                .setBackground("#D97706")
                .setFontColor("#FFFFFF");


        } else if (
            status === "ACTION"
        ) {

            cell
                .setBackground("#DC2626")
                .setFontColor("#FFFFFF");


        } else {

            cell
                .setBackground("#475569")
                .setFontColor("#CBD5E1");
        }


        cell
            .setFontWeight("bold");
    }


    /*************************************************************
     * TOP DEFECTS
     *************************************************************/
    const defects = {};


    const data =
        sheet
            .getRange(
                2,
                1,
                sheet.getLastRow() - 1,
                Math.max(
                    sheet.getLastColumn(),
                    11
                )
            )
            .getValues();


    data.forEach(row => {

        if (!row[0]) return;


        const dateKey =
            getDateKey_(
                row[0],
                timezone
            );


        if (
            dateKey !==
            selectedDateKey
        ) {
            return;
        }


        const buyer =
            String(
                row[3] || ""
            ).trim();


        const style =
            String(
                row[4] || ""
            ).trim();


        const po =
            String(
                row[5] || ""
            ).trim();


        if (
            buyerFilter !== "ALL" &&
            buyer !== buyerFilter
        ) {
            return;
        }


        if (
            styleFilter !== "ALL" &&
            style !== styleFilter
        ) {
            return;
        }


        if (
            poFilter !== "ALL" &&
            po !== poFilter
        ) {
            return;
        }


        const code =
            String(
                row[9] || ""
            ).trim();


        const description =
            String(
                row[10] || ""
            ).trim();


        const defectPCS =
            Number(row[8]) || 0;


        if (
            defectPCS <= 0
        ) {
            return;
        }


        const defectName =
            description ||
            code ||
            "Unknown Defect";


        if (
            !defects[defectName]
        ) {
            defects[defectName] = 0;
        }


        defects[defectName] +=
            defectPCS;
    });


    const topDefects =
        Object
            .keys(defects)
            .map(name => {

                return {
                    name: name,
                    pcs: defects[name]
                };
            })
            .sort(
                (a, b) =>
                    b.pcs - a.pcs
            )
            .slice(0, 8);


    if (
        topDefects.length === 0
    ) {

        display
            .getRange("J32")
            .setValue(
                "No defect data"
            )
            .setFontColor("#94A3B8");

        return;
    }


    const defectRows =
        topDefects.map(
            defect => [
                defect.name,
                defect.pcs,
                ""
            ]
        );


    display
        .getRange(
            32,
            10,
            defectRows.length,
            3
        )
        .setValues(defectRows);


    display
        .getRange(
            32,
            11,
            defectRows.length,
            1
        )
        .setNumberFormat("#,##0");


    display
        .getRange(
            32,
            10,
            defectRows.length,
            3
        )
        .setHorizontalAlignment("center");


    /*
     * Visual defect bars.
     */
    const maxDefect =
        topDefects[0].pcs ||
        1;


    for (
        let i = 0;
        i < topDefects.length;
        i++
    ) {

        const barLength =
            Math.max(
                1,
                Math.round(
                    (
                        topDefects[i].pcs /
                        maxDefect
                    ) * 15
                )
            );


        display
            .getRange(
                32 + i,
                12
            )
            .setValue(
                "█".repeat(
                    barLength
                )
            )
            .setFontColor("#F59E0B")
            .setFontSize(11);
    }
}


