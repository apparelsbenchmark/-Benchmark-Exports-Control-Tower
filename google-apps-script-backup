    /*
     * Remove all old merged cells.
     */
    try {

        sheet
            .getRange(
                1,
                1,
                sheet.getMaxRows(),
                sheet.getMaxColumns()
            )
            .breakApart();

    } catch (err) {
        console.log(err);
