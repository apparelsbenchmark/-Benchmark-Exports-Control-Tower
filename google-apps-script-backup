/***************************************************************
 * BENCHMARK EXPORTS
 * PRODUCTION + QUALITY CONTROL TOWER
 *
 * VERSION: FINAL
 *
 * SHEETS:
 *   1. INPUT
 *   2. QUALITY INPUT
 *   3. SETUP
 *   4. Benchmark Exports
 *
 * IMPORTANT:
 * createProductionSystem() DOES NOT DELETE EXISTING
 * PRODUCTION DATA FROM INPUT.
 ***************************************************************/


/***************************************************************
 * CONFIGURATION
 ***************************************************************/
const CONFIG = {

    INPUT_SHEET: "INPUT",
    QUALITY_SHEET: "QUALITY INPUT",
    SETUP_SHEET: "SETUP",
    DISPLAY_SHEET: "Benchmark Exports",

    NUMBER_OF_LINES: 14,
    NUMBER_OF_HOURS: 11,

    HEADER_ROW: 6,
    FIRST_LINE_ROW: 7,

    HOURLY_PLAN_ROW: 21,
    CUM_ACTUAL_ROW: 22,
    CUM_PLAN_ROW: 23,
    DAILY_PLAN_ROW: 24,
    VARIANCE_PCS_ROW: 25,
    VARIANCE_HRS_ROW: 26,

    QUALITY_TITLE_ROW: 29,
    QUALITY_HEADER_ROW: 31,
    QUALITY_FIRST_ROW: 32,

    TOTAL_COLUMNS: 18
};


/***************************************************************
 * MAIN FUNCTION
 ***************************************************************/
function createProductionSystem() {

    const ss = SpreadsheetApp.getActiveSpreadsheet();

    const input =
        getOrCreateSheet_(ss, CONFIG.INPUT_SHEET);

    const quality =
        getOrCreateSheet_(ss, CONFIG.QUALITY_SHEET);

    const setup =
        getOrCreateSheet_(ss, CONFIG.SETUP_SHEET);

    const display =
        getOrCreateSheet_(ss, CONFIG.DISPLAY_SHEET);


    /*
     * IMPORTANT:
     * These functions DO NOT clear existing INPUT data.
     */
    repairInputSheet_(input);

    repairQualitySheet_(quality);

    repairSetupSheet_(setup);


    /*
     * Dashboard can safely be rebuilt.
     */
    createDashboard_(display);


    /*
     * Populate dashboard.
     */
    updateProductionDisplay();


    SpreadsheetApp.getUi().alert(
        "Benchmark Exports Production & Quality Control Tower created successfully.\n\n" +
        "Existing INPUT data has been preserved."
    );
}


/***************************************************************
 * GET OR CREATE SHEET
 ***************************************************************/
function getOrCreateSheet_(ss, name) {

    let sheet = ss.getSheetByName(name);

    if (!sheet) {
        sheet = ss.insertSheet(name);
    }

    return sheet;
}


/***************************************************************
 * INPUT SHEET
 *
 * Existing data is preserved.
 ***************************************************************/
function repairInputSheet_(sheet) {

    const headers = [
        "Date",
        "Time",
        "Line",
        "Hour",
        "Buyer",
        "Style",
        "PO",
        "Color",
        "PCS"
    ];


    /*
     * Create headers if sheet is empty.
     */
    if (sheet.getLastRow() === 0) {

        sheet.getRange(
            1,
            1,
            1,
            headers.length
        ).setValues([headers]);

    } else {

        /*
         * Add missing headers only.
         * Existing rows remain untouched.
         */
        const currentHeaders =
            sheet.getRange(
                1,
                1,
                1,
                Math.max(sheet.getLastColumn(), headers.length)
            ).getValues()[0];

        for (let i = 0; i < headers.length; i++) {

            if (!currentHeaders[i]) {

                sheet
                    .getRange(1, i + 1)
                    .setValue(headers[i]);
            }
        }
    }


    /*
     * Header formatting.
     */
    formatHeader_(
        sheet.getRange(
            1,
            1,
            1,
            headers.length
        )
    );


    sheet.setFrozenRows(1);


    /*
     * Number formats.
     */
    if (sheet.getMaxRows() > 1) {

        sheet
            .getRange(
                2,
                1,
                sheet.getMaxRows() - 1,
                1
            )
            .setNumberFormat("dd-mmm-yyyy");

        sheet
            .getRange(
                2,
                2,
                sheet.getMaxRows() - 1,
                1
            )
            .setNumberFormat("hh:mm");

        sheet
            .getRange(
                2,
                9,
                sheet.getMaxRows() - 1,
                1
            )
            .setNumberFormat("#,##0");
    }


    /*
     * Line validation.
     */
    if (sheet.getMaxRows() > 1) {

        const lineRule =
            SpreadsheetApp.newDataValidation()
                .requireNumberBetween(
                    1,
                    CONFIG.NUMBER_OF_LINES
                )
                .setAllowInvalid(true)
                .build();

        sheet
            .getRange(
                2,
                3,
                sheet.getMaxRows() - 1,
                1
            )
            .setDataValidation(lineRule);


        /*
         * Hour validation.
         */
        const hourRule =
            SpreadsheetApp.newDataValidation()
                .requireNumberBetween(
                    1,
                    CONFIG.NUMBER_OF_HOURS
                )
                .setAllowInvalid(true)
                .build();

        sheet
            .getRange(
                2,
                4,
                sheet.getMaxRows() - 1,
                1
            )
            .setDataValidation(hourRule);
    }


    /*
     * Filter.
     */
    try {

        if (sheet.getFilter()) {
            sheet.getFilter().remove();
        }

        sheet
            .getRange(
                1,
                1,
                Math.max(sheet.getLastRow(), 2),
                headers.length
            )
            .createFilter();

    } catch (err) {
        console.log(err);
    }


    sheet.autoResizeColumns(
        1,
        headers.length
    );
}


