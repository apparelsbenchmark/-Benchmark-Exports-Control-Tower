# Apps Script Web App URL ending in /exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
# Copy the API token shown by setupEnterpriseControlTower()
APPS_SCRIPT_TOKEN=REPLACE_WITH_LONG_TOKEN
# Shared fallback PIN. Keep private; never commit .env.local.
CONTROL_TOWER_PIN=CHANGE_THIS_TO_A_PRIVATE_PIN
# Optional separate PINs. If left blank, each role uses CONTROL_TOWER_PIN.
SUPERVISOR_ACCESS_PIN=
ADMIN_ACCESS_PIN=
